package [[.Package]]

import (
	"github.com/alternayte/avero"

	"[[.Module]]/internal/features/[[.Package]]/model"
)

// View is one [[.Singular]] as the answer carries it.
type View struct {
	// ID identifies the row.
	ID string `json:"id"`
	// Title is the name that a person reads.
	Title string `json:"title"`
}

// ViewList is the answer of the list call.
type ViewList struct {
	// Items holds every row, newest first.
	Items []View `json:"[[.Plural]]"`
}

// List answers every [[.Singular]].
func (m *Module) List(c *avero.Ctx, in ListInput) (ViewList, error) {
	rows, err := m.store.List(c, in.Search)
	if err != nil {
		return ViewList{}, err
	}
	out := make([]View, 0, len(rows))
	for _, row := range rows {
		out = append(out, view(row))
	}
	return ViewList{Items: out}, nil
}

// Create writes one [[.Singular]].
func (m *Module) Create(c *avero.Ctx, in CreateInput) (View, error) {
	row, err := m.store.Create(c, in.Title)
	if err != nil {
		return View{}, err
	}
	return view(row), nil
}

// Show answers one [[.Singular]].
func (m *Module) Show(c *avero.Ctx, in ShowInput) (View, error) {
	row, found, err := m.store.Get(c, in.ID)
	if err != nil {
		return View{}, err
	}
	if !found {
		// The router writes the problem document. See RFC 9457.
		return View{}, avero.NotFound("[[.Singular]]", in.ID)
	}
	return view(row), nil
}

// Delete removes one [[.Singular]].
func (m *Module) Delete(c *avero.Ctx, in DeleteInput) (avero.NoBody, error) {
	if err := m.store.Delete(c, in.ID); err != nil {
		return avero.NoBody{}, err
	}
	return avero.NoBody{}, nil
}

// view maps one row to the answer of the API.
func view(row *model.[[.Type]]) View {
	return View{ID: row.ID().String(), Title: row.Title}
}
