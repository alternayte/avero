module [[.Module]]

go [[.GoVersion]]

require github.com/alternayte/avero [[.Avero]]

require github.com/alternayte/drel [[.Drel]]

// drel writes the models, the repositories and the migrations of each feature
// slice. `avero generate` and `avero migrate` run it, so a person needs no
// second tool.
tool github.com/alternayte/drel/cmd/drel
[[if .SSR]]
require github.com/a-h/templ [[.Templ]]

// The templ generator writes the Go file of each .templ file. `avero generate`
// and `avero dev` run it, so a person needs no second tool.
tool github.com/a-h/templ/cmd/templ
[[end]][[if .Replace]]
replace github.com/alternayte/avero => [[.Replace]]
[[end]]
