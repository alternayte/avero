package [[.Package]]

import (
	"github.com/alternayte/avero"

	"[[.Module]]/internal/features/[[.Package]]/model"
)

// View is one [[.Singular]] as the answer carries it.
type View struct {
	// ID identifies the row.
	ID string `json:"id"`
	// Title is the name that a person reads.
	Title string `json:"title"`
}

// ViewList is the answer of the list call.
type ViewList struct {
	// Items holds every row, newest first.
	Items []View `json:"[[.Plural]]"`
}

// List answers every [[.Singular]].
func (m *Module) List(c *avero.Ctx, in ListInput) (avero.Result[ViewList], error) {
	rows, err := m.store.List(c.Context(), in.Search)
	if err != nil {
		return avero.Result[ViewList]{}, err
	}
	out := make([]View, 0, len(rows))
	for _, row := range rows {
		out = append(out, view(row))
	}
	return avero.OK(ViewList{Items: out}), nil
}

// Create writes one [[.Singular]].
func (m *Module) Create(c *avero.Ctx, in CreateInput) (avero.Result[View], error) {
	row, err := m.store.Create(c.Context(), in.Title)
	if err != nil {
		return avero.Result[View]{}, err
	}
	return avero.Created(view(row)), nil
}

// Show answers one [[.Singular]].
func (m *Module) Show(c *avero.Ctx, in ShowInput) (avero.Result[View], error) {
	row, found, err := m.store.Get(c.Context(), in.ID)
	if err != nil {
		return avero.Result[View]{}, err
	}
	if !found {
		// The router writes the problem document. See RFC 9457.
		return avero.Result[View]{}, avero.NotFound("[[.Singular]]", in.ID)
	}
	return avero.OK(view(row)), nil
}

// Delete removes one [[.Singular]].
func (m *Module) Delete(c *avero.Ctx, in DeleteInput) (avero.Result[avero.NoBody], error) {
	if err := m.store.Delete(c.Context(), in.ID); err != nil {
		return avero.Done(), err
	}
	return avero.Done(), nil
}

// view maps one row to the answer of the API.
func view(row *model.[[.Type]]) View {
	return View{ID: row.ID().String(), Title: row.Title}
}
