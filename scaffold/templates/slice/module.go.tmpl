// Package [[.Package]] holds the [[.Name]] feature: its routes, its handlers,
// its input types, its store and its tests. It imports no other feature.
package [[.Package]]

import (
	"net/http"

	"github.com/alternayte/avero"
	"github.com/alternayte/drel"
)

//go:generate go run github.com/alternayte/avero/internal/cmd/averogen .

// Module is the [[.Name]] feature.
type Module struct {
	// store reads and writes the rows of the feature.
	store *Store
}

// New builds the feature. main.go supplies the engine. See design rule 3.
func New(engine *drel.Engine) *Module { return &Module{store: NewStore(engine)} }

// Name identifies the module in the contribution table.
func (m *Module) Name() string { return "[[.Name]]" }

// The description of this module needs no hand-written method. `avero
// generate` writes the models from the model package, and the module system
// reads the routes from this method. See AN-3.
// Routes registers the routes of the feature.
func (m *Module) Routes(r *avero.Router) {
	avero.Get(r, "/[[.Plural]]", m.List)
	avero.Post(r, "/[[.Plural]]", m.Create)
	avero.Get(r, "/[[.Plural]]/{id}", m.Show,
		avero.Answers[avero.Problem](http.StatusNotFound, "the [[.Singular]] does not exist"))
	avero.Delete(r, "/[[.Plural]]/{id}", m.Delete)
}
