# Copy this file to .env and read it into the environment before you run the
# application. `avero doctor` names every variable that is absent.

# The signing key of the CSRF cookie and of the flash cookie. Write a new one
# with `openssl rand -hex 32`.
AVERO_SECRET=c755be44bd01f951c1fa427455c7c4a8b1ff6501b11707a27f1534f635182811

# The database. SQLite needs no server. PostgreSQL reads
# postgres://user:password@localhost:5432/blog.
DATABASE_URL=file:blog.db

# The port of the HTTP server.
PORT=8080

# The environment: development or production.
AVERO_ENV=development
