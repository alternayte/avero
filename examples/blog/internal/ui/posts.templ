package ui

import "github.com/alternayte/avero/view"

// PostList renders every post.
//
// The delete button carries a Datastar action. The server answers with a patch
// that removes the row, so the page changes with no reload. See S12.
templ PostList(rows []PostRow) {
	<h1>Posts</h1>
	<p><a href="/posts/new">Write a post</a></p>
	<p id="posts-empty" class="empty">
		if len(rows) == 0 {
			No post exists yet.
		}
	</p>
	<ul class="posts">
		for _, row := range rows {
			@PostRowItem(row)
		}
	</ul>
}

// PostRowItem renders one row of the list.
templ PostRowItem(row PostRow) {
	<li id={ "post-" + row.ID }>
		<a href={ templ.URL("/posts/" + row.ID) }>{ row.Title }</a>
		<button
			type="button"
			class="btn"
			data-variant="destructive"
			data-on-click={ "@delete('/posts/" + row.ID + "', {headers: {'X-CSRF-Token': $csrf}})" }
		>Delete</button>
	</li>
}

// PostDetail renders one post and the button that deletes it.
templ PostDetail(row PostRow) {
	<article>
		<h1>{ row.Title }</h1>
		<p>{ row.Body }</p>
	</article>
	<p>
		<a href="/">Back to the posts</a>
		<button
			type="button"
			class="btn"
			data-variant="destructive"
			data-on-click={ "@delete('/posts/" + row.ID + "', {headers: {'X-CSRF-Token': $csrf}})" }
		>Delete</button>
	</p>
}

// NewPostForm renders the form of a new post. It renders again after a
// validation fault, with the old input and the field errors. See S10.
templ NewPostForm() {
	<h1>New post</h1>
	<form method="post" action="/posts">
		@view.CSRF()
		@Field("title", "Title")
		@Area("body", "Body")
		<button type="submit" class="btn">Save</button>
	</form>
}

// Field renders one text field with its old value and its error.
templ Field(name string, label string) {
	<div class="grid gap-2">
		<label for={ name } class="label">{ label }</label>
		<input id={ name } name={ name } value={ view.Old(ctx, name) } class="input"/>
		@Error(name)
	</div>
}

// Area renders one text area with its old value and its error.
templ Area(name string, label string) {
	<div class="grid gap-2">
		<label for={ name } class="label">{ label }</label>
		<textarea id={ name } name={ name } class="textarea">{ view.Old(ctx, name) }</textarea>
		@Error(name)
	</div>
}

// Error renders the validation message of one field.
templ Error(name string) {
	if view.HasError(ctx, name) {
		<span class="text-destructive text-sm">{ view.Error(ctx, name) }</span>
	}
}

// NotFound renders the page of an absent post.
templ NotFound() {
	<h1>Absent</h1>
	<p>The post does not exist.</p>
}
